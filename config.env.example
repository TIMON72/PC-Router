# PC-Router — пример конфигурации площадки
#
# 1) Скопируйте этот файл:
#      cp config.env.example config.env
# 2) Отредактируйте config.env под железо и сеть
# 3) На устройстве рабочий файл всегда лежит в каталоге проекта:
#      /home/admin/PC-Router/config.env
#
# deploy/upgrade НЕ перезаписывают config.env — правьте только на площадке
# или копируйте осознанно.
#
# Значения с пробелами или «;» обязательно в кавычках:
#   DEVICE_LEASES='aa:bb:...,host1;cc:dd:...,host2'

# =============================================================================
# Интерфейсы
# =============================================================================
# Имена смотрите:  ip -br link
# WAN — кабель в интернет (DHCP от провайдера/роутера)
# LAN — раздача сети устройствам (статический адрес роутера)
# LTE — PPP-интерфейс модема (обычно появляется как ppp0)

WAN_IF=enp3s0
LAN_IF=enp4s0
LTE_IF=ppp0

# =============================================================================
# Внешний доступ к площадке (edge)
# =============================================================================
# vpn     — OpenVPN-туннель; проброс портов вешается на VPN_IF
# whiteip — публичный IP на WAN (или WHITE_IF); без OpenVPN
# none    — только интернет в LAN + failover; без edge-мониторинга и DNAT

EDGE_MODE=vpn

# --- EDGE_MODE=vpn ---
VPN_IF=tun0
# Unit systemd = имя файла без .conf в /etc/openvpn/
#   vpn.conf → openvpn@vpn.service
OPENVPN_UNIT=openvpn@vpn.service
# Опционально: ICMP внутри VPN (пусто = достаточно IPv4 на VPN_IF)
# VPN_PING_HOST=

# --- EDGE_MODE=whiteip ---
# WHITE_IF=enp3s0          # по умолчанию = WAN_IF
# WHITE_IP=203.0.113.10    # ожидаемый адрес (пусто = любой IPv4 на WHITE_IF)
# WHITE_PING_HOST=         # опциональный контрольный пинг

# =============================================================================
# LAN: адрес роутера и DHCP
# =============================================================================
# Роутер раздаёт адреса в LAN_NET. Сам сидит на LAN_ADDR.

LAN_CIDR=192.168.50.1/24
LAN_ADDR=192.168.50.1
LAN_NET=192.168.50.0/24
DHCP_RANGE_START=192.168.50.10
DHCP_RANGE_END=192.168.50.100
DHCP_LEASE=12h
DHCP_DNS=8.8.8.8,1.1.1.1

# =============================================================================
# Устройства в LAN (опционально)
# =============================================================================
# Статический DHCP по MAC (устройство всегда получает один IP):
#   DEVICE_LEASES='MAC,IP,HOSTNAME;MAC,IP,HOSTNAME'
# HOSTNAME можно опустить: 'MAC,IP'
#
# Пример:
# DEVICE_LEASES='aa:bb:cc:dd:ee:01,192.168.50.101,door-cam;aa:bb:cc:dd:ee:02,192.168.50.102,nvr'
#
# Совместимость: старое имя CAMERA_LEASES ещё читается, если DEVICE_LEASES пуст.
DEVICE_LEASES=

# Проброс TCP с edge (VPN или white IP) → устройство в LAN:
#   DEVICE_FORWARDS='EDGE_PORT:LAN_IP:LAN_PORT;...'
#
# Пример: с VPN зайти на порт 8001 → веб камеры 192.168.50.101:80
# DEVICE_FORWARDS='8001:192.168.50.101:80;8002:192.168.50.102:80'
#
# Совместимость: CAMERA_FORWARDS ещё читается, если DEVICE_FORWARDS пуст.
DEVICE_FORWARDS=

# =============================================================================
# LTE-модем
# =============================================================================
# Устройство tty смотрите в dmesg / ls /dev/ttyUSB*
LTE_MODEM_DEV=/dev/ttyUSB0
# LTE_MODEM_AT_DEV=/dev/ttyUSB2   # если AT на другом порту
APN_PROFILES_FILE=/home/admin/PC-Router/conf/apn-profiles.conf
APN_LAST_FILE=/home/admin/PC-Router/state/apn.last
REBOOT_STATE_DIR=/home/admin/PC-Router/state

# =============================================================================
# Проверки uplink
# =============================================================================
PING_HOST=8.8.8.8
PING_HOST_ALT=1.1.1.1
# EDGE_CHECK_HOST=              # доп. хост для check_internet (опционально)

LTE_UNIT=lte.service

# =============================================================================
# Failover (WAN ↔ LTE)
# =============================================================================
# CHECK_INTERVAL        — секунды между проверками
# FAIL_THRESHOLD        — сколько fail подряд → считать канал мёртвым
# RECOVER_THRESHOLD     — сколько ok подряд → вернуть канал
# MIN_SWITCH_INTERVAL   — минимум секунд между переключениями
# LTE_RESTART_COOLDOWN  — пауза между рестартами LTE
# APN_NEXT_AFTER_FAILS  — после N fail LTE пробовать следующий APN
# LTE_MODEM_WAIT_SEC    — ожидание модема при старте
# VPN_RESTART_COOLDOWN  — пауза между рестартами OpenVPN

CHECK_INTERVAL=5
FAIL_THRESHOLD=2
RECOVER_THRESHOLD=2
MIN_SWITCH_INTERVAL=10
LTE_RESTART_COOLDOWN=300
APN_NEXT_AFTER_FAILS=3
LTE_MODEM_WAIT_SEC=90
VPN_RESTART_COOLDOWN=45

# =============================================================================
# Логи (пути относительно каталога проекта)
# =============================================================================
NETLOG_DIR=/home/admin/PC-Router
NETLOG_FILE=/home/admin/PC-Router/logs.log
LOG_FILE=/home/admin/PC-Router/lte-failover.log

# =============================================================================
# Reboot при полном outage (нет ни WAN, ни LTE)
# =============================================================================
# REBOOT_ON_OUTAGE=1 включает эскалацию.
# REBOOT_SCHEDULE_SEC — паузы до reboot (секунды), через запятую.
REBOOT_ON_OUTAGE=1
REBOOT_SCHEDULE_SEC=3600,7200,14400,21600,43200,86400

# =============================================================================
# Плановая перезагрузка (пусто REBOOT_SCHEDULE_KIND = выкл)
# =============================================================================
# KIND: daily | weekly | monthly
# TIME: HH:MM (локальное время устройства)
# DAY:  weekly — Sun|Mon|…|Sat; monthly — день месяца 1–31
REBOOT_SCHEDULE_KIND=weekly
REBOOT_SCHEDULE_TIME=04:00
REBOOT_SCHEDULE_DAY=Sun
# REBOOT_SCHEDULE_ONCALENDAR=Sun *-*-* 04:00:00
