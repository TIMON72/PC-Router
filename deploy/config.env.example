# PC-side deploy config (не путать с корневым config.env площадки на роутере).
#
# Из исходников:  copy deploy\config.env.example deploy\config.env
# Полевой kit:    build/dist/config.env  (рядом с pcrouter.exe)
#
# Устройство задаётся в CLI:  pcrouter.exe pc-62 test --all 2h
# ACTIVE — fallback, если device в команде не указан.

ACTIVE=62

# --- lab .62 (тесты) ---
[62]
DEVICE_NAME=pc-62
HOST=10.181.19.62
USER=admin
PASS=
REMOTE_ROOT=/home/admin/PC-Router
# SSH_KEY=

# --- site .60 (пока не используем) ---
[60]
DEVICE_NAME=pc-60
HOST=10.181.19.60
USER=admin
PASS=
REMOTE_ROOT=/home/admin/PC-Router
