# Ускоренный failover (минуты, не десятки минут)
CHECK_INTERVAL=3
FAIL_THRESHOLD=2
RECOVER_THRESHOLD=2
MIN_SWITCH_INTERVAL=5
LTE_RESTART_COOLDOWN=30
VPN_RESTART_COOLDOWN=20
APN_NEXT_AFTER_FAILS=3
LTE_RECOVER_PPP_TRIES=3
LTE_RECOVER_CFUN_TRIES=1
LTE_RECOVER_USB_TRIES=1
# Не ждать ~3 мин после каждого restart — иначе лестница не успевает за observe
LTE_RECOVER_WAIT_LOOPS=6
LTE_RECOVER_WAIT_SLEEP=3
APN_NEXT_COOLDOWN_SEC=900
